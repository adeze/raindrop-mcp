{
  "name": "@adeze/raindrop-mcp",
  "version": "2.4.5",
  "description": "MCP Server for Raindrop.io bookmark management",
  "main": "build/index.js",
  "module": "build/index.js",
  "type": "module",
  "bin": {
    "raindrop-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "private": false,
  "scripts": {
    "dev": "bun run build && bun --watch src/index.ts",
    "dev:http": "bun run build && bun --watch src/server.ts",
    "inspector": "bunx @modelcontextprotocol/inspector node --env-file=.env build/index.js",
    "inspector:http-server": "bunx @modelcontextprotocol/inspector node --env-file=.env build/server.js",
    "type-check": "vp check --no-fmt --no-lint",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "bun run build && vp test run",
    "test:watch": "vp test",
    "test:coverage": "bun run build && vp test run --coverage",
    "test:e2e": "vp test run tests/mcp.integration.test.ts",
    "auth:check": "node scripts/auth-check.mjs",
    "run": "bun run build/index.js",
    "build": "vp pack",
    "start:prod": "bun run build/index.js",
    "start:http": "bun run src/server.ts",
    "clean": "rm -rf build",
    "bun:update": "bun update",
    "update:deps": "bun update --latest && bun add --dev @vitest/coverage-v8@5.0.3 && bun add --cwd tooling/compiler-api --dev typescript@~6.0.3",
    "update:deps:interactive": "bun update --interactive --latest && bun add --dev @vitest/coverage-v8@5.0.3 && bun add --cwd tooling/compiler-api --dev typescript@~6.0.3",
    "mcpb:pack": "jq \".version = \\\"$(jq -r .version package.json)\\\"\" manifest.json > manifest.json.tmp && mv manifest.json.tmp manifest.json && bun run build && bunx @anthropic-ai/mcpb@latest pack . raindrop-mcp.mcpb && bunx @anthropic-ai/mcpb@latest clean raindrop-mcp.mcpb",
    "generate:schema": "bun run --cwd tooling/compiler-api generate:schema",
    "release": "semantic-release",
    "docs": "bun run --cwd tooling/compiler-api docs",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "check": "vp check"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "vp lint --fix",
      "vp fmt"
    ],
    "*.{json,md,yml,yaml}": [
      "vp fmt"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeze/raindrop-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "raindrop.io",
    "modelcontextprotocol",
    "mcp-server",
    "raindrop",
    "bookmarks",
    "ai-assistant",
    "llm-tools",
    "typescript"
  ],
  "author": "Adam E",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adeze/raindrop-mcp/issues"
  },
  "homepage": "https://github.com/adeze/raindrop-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "keyv": "^6.1.0",
    "openapi-fetch": "^0.17.0",
    "rate-limiter-flexible": "^11.2.1",
    "simple-oauth2": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.10.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "tooling/compiler-api"
  ]
}
